[Unit]
Description=Net-monit V10.6 Network Monitor
Documentation=https://Abdullah-InfoXtek.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netmonit
Group=netmonit
WorkingDirectory=/opt/netmonit-v106
ExecStart=/opt/netmonit-v106/venv/bin/python /opt/netmonit-v106/app.py
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netmonit-v106
Environment=PYTHONUNBUFFERED=1
Environment=NETMON_PORT=50106
Environment=NETMON_SVC_NAME=netmonit-v106

[Install]
WantedBy=multi-user.target
