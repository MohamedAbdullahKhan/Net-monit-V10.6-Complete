[Unit]
Description=Net-monit V10.7 Network Monitor
Documentation=https://Abdullah-InfoXtek.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netmonit
Group=netmonit
WorkingDirectory=/opt/netmonit-v107
ExecStart=/opt/netmonit-v107/venv/bin/python /opt/netmonit-v107/app.py
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netmonit-v107
Environment=PYTHONUNBUFFERED=1
Environment=NETMON_PORT=50107
Environment=NETMON_SVC_NAME=netmonit-v107

[Install]
WantedBy=multi-user.target
